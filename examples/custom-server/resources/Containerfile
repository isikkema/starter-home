FROM docker.io/debian:13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash server \
    && passwd -d server \
    && mkdir -p /run/sshd /home/server/.ssh \
    && chown -R server:server /home/server

COPY sshd_config /etc/ssh/sshd_config
COPY entrypoint.sh /usr/local/bin/starter-home-sshd
RUN chmod 0755 /usr/local/bin/starter-home-sshd

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/starter-home-sshd"]
